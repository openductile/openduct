# Copy to .env, set every value, and make it yours alone: chmod 600 .env. `openssl rand -hex 32` makes a good
# secret. Each reaches its container as a file under /run/secrets, never as an environment variable.

# Shared by the nodes of a cluster, and seals the studio's keys: keep it for good.
OPENDUCT_CLUSTER_SECRET=

# The S3 store's keys (OpenDuct uses them too).
S3_ACCESS_KEY=openduct
S3_SECRET_KEY=

# The database's password; workflows' postgres credentials use it (host postgres, database openduct).
POSTGRES_PASSWORD=
